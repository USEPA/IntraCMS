<?php

/**
 * @file
 * Install, update and uninstall functions for the epa_core module.
 */

/**
 * Implements hook_update_dependencies().
 * Ensures sequential mapping rules are strictly enforced.
 */
function epa_core_update_dependencies() {
  $dependencies['group'] = [
    'epa_core' => 9001,
  ];
  return $dependencies;
}

/**
 * Hard-shred legacy data rows and configs blocking the Group 2.x migration.
 */
function epa_core_update_9001() {
  $database = \Drupal::database();
  $purged_rows = 0;
  $filter = '%group%taxo%';

  // 1. Clear base content and field storage maps
  if ($database->schema()->tableExists('group_content')) {
    $purged_rows += $database->delete('group_content')->condition('type', $filter, 'LIKE')->execute();
  }
  if ($database->schema()->tableExists('group_content_field_data')) {
    $purged_rows += $database->delete('group_content_field_data')->condition('type', $filter, 'LIKE')->execute();
  }

  // 2. BEST PRACTICE ADDITION: Purge historical revision tables to prevent orphaned log states
  if ($database->schema()->tableExists('group_content_revision')) {
    $database->delete('group_content_revision')->condition('type', $filter, 'LIKE')->execute();
  }
  if ($database->schema()->tableExists('group_content_field_revision')) {
    $database->delete('group_content_field_revision')->condition('type', $filter, 'LIKE')->execute();
  }

  // 3. Clear the ghost configuration artifacts
  if ($database->schema()->tableExists('config')) {
    $purged_rows += $database->delete('config')->condition('name', $filter, 'LIKE')->execute();
  }

  // 4. BEST PRACTICE ADDITION: Forcefully invalidate internal entity storage and memory registries
  \Drupal::entityTypeManager()->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  
  if ($database->schema()->tableExists('cache_discovery')) {
    $database->truncate('cache_discovery')->execute();
  }

  return t('Pristine: Forcefully purged @count legacy entries and invalidated system caches to clear the Group 2.x path.', ['@count' => $purged_rows]);
}

/**
 * Deep-sanitizes configuration data columns to purge hidden serialized plugin references.
 */
function epa_core_update_9002() {
  $database = \Drupal::database();
  $purged_rows = 0;
  
  // Wildcards targeting our legacy dependency footprints
  $taxonomy_filter = '%group%taxo%';
  $menu_filter = '%groupmenu%';

  if ($database->schema()->tableExists('config')) {
    // 1. Shred configurations holding the old taxonomy strings inside their data text bodies
    $purged_rows += $database->delete('config')
      ->condition('data', $taxonomy_filter, 'LIKE')
      ->execute();

    // 2. NEW CRITICAL ADDITION: Hard-delete legacy block placements and views built for groupmenu
    $purged_rows += $database->delete('config')
      ->condition('name', $menu_filter, 'LIKE')
      ->execute();
    $purged_rows += $database->delete('config')
      ->condition('data', $menu_filter, 'LIKE')
      ->execute();
  }

  // 3. Clear key_value state tracking flags for both items
  if ($database->schema()->tableExists('key_value')) {
    $database->delete('key_value')->condition('name', $taxonomy_filter, 'LIKE')->execute();
    $database->delete('key_value')->condition('value', $taxonomy_filter, 'LIKE')->execute();
    $database->delete('key_value')->condition('name', $menu_filter, 'LIKE')->execute();
    $database->delete('key_value')->condition('value', $menu_filter, 'LIKE')->execute();
  }

  // 4. Truncate cache tables to enforce a clean container compilation map
  $cache_bins = ['cache_discovery', 'cache_config', 'cache_container', 'cache_bootstrap'];
  foreach ($cache_bins as $bin) {
    if ($database->schema()->tableExists($bin)) {
      $database->truncate($bin)->execute();
    }
  }

  // 5. Invalidate structural system memory layers
  \Drupal::service('kernel')->invalidateContainer();
  \Drupal::entityTypeManager()->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  return t('Pristine: Deeply sanitized @count data elements to protect the container cache compilation pass.', ['@count' => $purged_rows]);
}
/**
 * Programmatic recovery pass to restore a missing or empty core.extension record.
 * Leverages the primary sync blueprint to clear the profile validation gate.
 */
function epa_core_update_9003() {
  $database = \Drupal::database();

  if ($database->schema()->tableExists('config')) {
    // 1. Double-check if the row is actually missing from the table
    $exists = $database->select('config', 'c')
      ->fields('c', ['name'])
      ->condition('name', 'core.extension')
      ->execute()
      ->fetchField();

    if (!$exists) {
      // 2. Direct Core Path Mapping: Target your main sync folder above docroot
      $app_root = \Drupal::root();
      $file_path = $app_root . '/../config/sync/core.extension.yml';

      // Fallback path wrapper depending on container deployment configurations
      if (!file_exists($file_path)) {
        $file_path = $app_root . '/config/sync/core.extension.yml';
      }

      if (file_exists($file_path)) {
        // 3. Read the authentic raw string data directly off your branch codebase
        $raw_yaml = file_get_contents($file_path);
        $parsed_data = \Drupal\Component\Serialization\Yaml::decode($raw_yaml);

        if ($parsed_data && isset($parsed_data['profile'])) {
          // 4. Safely re-inject the complete profile and module registry mapping array
          $database->insert('config')
            ->fields([
              'collection' => '',
              'name' => 'core.extension',
              'data' => serialize($parsed_data),
            ])
            ->execute();
        }
      }
    }
  }
}