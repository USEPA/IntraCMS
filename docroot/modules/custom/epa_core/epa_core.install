<?php

/**
 * @file
 * Install/update hooks for epa_core.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Database\Database;

/**
 * Implements hook_update_dependencies().
 *
 * Ensures the Group patch 2797793 reversal runs before any Group 2.x
 * storage migration hooks begin. Without this pin, drush updb would run
 * group_update_9200 → 9211 against patched-1.6 storage and fail at 9203.
 *
 * NOTE: If additional epa_core reversal hooks are added (10002+), they must
 * also be pinned here if they need to run before specific group 2.x hooks.
 */
function epa_core_update_dependencies() {
  return [
    'group' => [
      9200 => [
        'epa_core' => 10001,
      ],
    ],
  ];
}

/**
 * Reverse Group patch 2797793 storage change prior to Group 2.x upgrade.
 *
 * Steps:
 *  1) Reinstall the legacy base-field 'entity_id' on group_content so that
 *     group_content_field_data.entity_id exists again.
 *  2) Backfill group_content_field_data.entity_id from
 *     group_content__entity_id.entity_id_target_id.
 *  3) Uninstall the patch's field storage for entity_id and entity_id_str,
 *     dropping group_content__entity_id and group_content__entity_id_str.
 *
 * NOTE: We do NOT realign Group's stored schema version here. Core's update
 * batch controller (DbUpdateController) writes `first_pending - 1` to
 * key_value['system.schema'] for every module in the pending set *before*
 * any hook_update_N runs. By the time this hook executes, group's stored
 * schema has already been normalized to 9199. The next batch operation
 * (group_update_9200) will overwrite it to 9200 on completion.
 */
function epa_core_update_10001() {
  $database = Database::getConnection();
  $schema = $database->schema();
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  // ---------------------------------------------------------------------------
  // Precondition 1: Patch 2797793 must actually be applied. The authoritative
  // signal is the presence of the patch-created field table. If this table
  // doesn't exist, the hook has nothing to reverse — either the patch was
  // never applied, or this hook already ran.
  // ---------------------------------------------------------------------------
  if (!$schema->tableExists('group_content__entity_id')) {
    throw new \RuntimeException(
      'epa_core_update_10001 aborted: group_content__entity_id table not found. ' .
      'This hook expects Group 1.6 with patch 2797793 applied. Either the ' .
      'patch was never applied, or this reversal already ran. Inspect manually.'
    );
  }

  // ---------------------------------------------------------------------------
  // Precondition 2: 1.x dependency modules must already be uninstalled.
  // This list MUST match the Phase 3 uninstall scope exactly.
  // ---------------------------------------------------------------------------
  $required_uninstalled = [
    'groupmenu',
    'group_taxonomy',
    'groupmenu_block',
    'group_outsider_in',
    'group_media_context',
    'gcontent_moderation',
  ];
  $still_enabled = [];
  foreach ($required_uninstalled as $module) {
    if (\Drupal::moduleHandler()->moduleExists($module)) {
      $still_enabled[] = $module;
    }
  }
  if (!empty($still_enabled)) {
    throw new \RuntimeException(
      'epa_core_update_10001 aborted: these modules must be uninstalled first: '
      . implode(', ', $still_enabled)
    );
  }

  // Capture total row count up front for the final return message and for
  // post-backfill verification.
  $total_rows = (int) $database->query("
    SELECT COUNT(*) FROM {group_content_field_data}
  ")->fetchField();

  // ---------------------------------------------------------------------------
  // Precondition 3: no orphan shells. Every row in group_content_field_data
  // must have a matching row in group_content__entity_id, otherwise backfill
  // will leave stale rows that will corrupt the 9203 migration.
  // ---------------------------------------------------------------------------
  $orphan_count = (int) $database->query("
    SELECT COUNT(*) FROM {group_content_field_data} gcfd
    LEFT JOIN {group_content__entity_id} ei
      ON ei.entity_id = gcfd.id AND ei.deleted = 0
    WHERE ei.entity_id IS NULL
  ")->fetchField();

  if ($orphan_count > 0) {
    throw new \RuntimeException(sprintf(
      'epa_core_update_10001 aborted: %d orphan shells detected in ' .
      'group_content_field_data (rows with no corresponding group_content__entity_id row). ' .
      'These must be cleaned via Phase 2 shell-cleanup SQL before this hook can run safely.',
      $orphan_count
    ));
  }

  // ---------------------------------------------------------------------------
  // Step 1: Reinstall legacy base-field 'entity_id' on group_content.
  // Matches stock Group 1.6 GroupContent::baseFieldDefinitions() shape.
  // Stock 1.6 does NOT set target_type on the base definition — plugins
  // override it per bundle. Do not add setSetting('target_type', ...) here.
  // ---------------------------------------------------------------------------
  $entity_id_definition = BaseFieldDefinition::create('entity_reference')
    ->setLabel(t('Content'))
    ->setDescription(t('The entity to add to the group.'))
    ->setReadOnly(TRUE)
    ->setRequired(TRUE);

  // Idempotent: only install if not already present.
  if (!$definition_update_manager->getFieldStorageDefinition('entity_id', 'group_content')) {
    $definition_update_manager->installFieldStorageDefinition(
      'entity_id',
      'group_content',
      'group',
      $entity_id_definition
    );
  }

  // ---------------------------------------------------------------------------
  // Step 2: Backfill group_content_field_data.entity_id from field table.
  // The _str table has 0 rows (confirmed in Phase 1 analysis) so no string
  // backfill is needed.
  // ---------------------------------------------------------------------------
  if ($schema->fieldExists('group_content_field_data', 'entity_id')) {
    // Portable backfill (works on MySQL/MariaDB; adjust for Postgres if used).
    $database->query("
      UPDATE {group_content_field_data} gcfd
      INNER JOIN {group_content__entity_id} ei
        ON ei.entity_id = gcfd.id AND ei.deleted = 0
      SET gcfd.entity_id = ei.entity_id_target_id
    ");
  }

  // Post-backfill verification 1: no NULL entity_id values remain.
  $null_count = (int) $database->query("
    SELECT COUNT(*) FROM {group_content_field_data} WHERE entity_id IS NULL
  ")->fetchField();

  if ($null_count > 0) {
    throw new \RuntimeException(sprintf(
      'Backfill incomplete: %d group_content rows have NULL entity_id after backfill. ' .
      'Aborting before field storage drop. Investigate before retrying.',
      $null_count
    ));
  }

  // Post-backfill verification 2: row count sanity check.
  $post_backfill_count = (int) $database->query("
    SELECT COUNT(*) FROM {group_content_field_data}
  ")->fetchField();

  if ($post_backfill_count !== $total_rows) {
    throw new \RuntimeException(sprintf(
      'Row count mismatch: started with %d rows, now have %d. ' .
      'Backfill should not have changed row count. Aborting.',
      $total_rows,
      $post_backfill_count
    ));
  }

  // ---------------------------------------------------------------------------
  // Step 3: Uninstall patch field storage for entity_id and entity_id_str.
  // Preferred path: entity definition update manager (clean, updates key_value).
  // Fallback path: drop tables + prune key_value entries if the API cannot
  // resolve the field definitions (e.g., patch code already removed).
  // ---------------------------------------------------------------------------
  foreach (['entity_id', 'entity_id_str'] as $field_name) {
    $existing = $definition_update_manager->getFieldStorageDefinition($field_name, 'group_content');
    // The patch registered these as *configurable* field storage via
    // GroupContentReferenceDefinition. If the base-field reinstall in Step 1
    // replaced 'entity_id', the API will only still see 'entity_id_str' here.
    if ($existing && $existing->getProvider() !== 'group_content_base') {
      try {
        $definition_update_manager->uninstallFieldStorageDefinition($existing);
      }
      catch (\Throwable $e) {
        // Fall through to raw cleanup below. Log for forensics.
        \Drupal::logger('epa_core')->warning(
          'uninstallFieldStorageDefinition failed for @field: @msg. Falling back to raw cleanup.',
          ['@field' => $field_name, '@msg' => $e->getMessage()]
        );
      }
    }
  }

  // Raw cleanup fallback / finalization.
  foreach (['group_content__entity_id', 'group_content__entity_id_str'] as $table) {
    if ($schema->tableExists($table)) {
      $schema->dropTable($table);
    }
  }

  // Prune leftover entity definition bookkeeping and restore the base-field
  // definition unconditionally. Simpler and safer than conditional provider
  // checks, since Step 1 already installed the correct base definition.
  $kv = \Drupal::keyValue('entity.definitions.installed');
  $installed_defs = $kv->get('group_content.field_storage_definitions', []);
  if (is_array($installed_defs)) {
    // Remove patch artifact unconditionally.
    unset($installed_defs['entity_id_str']);
    // Overwrite entity_id with the known-good base definition from Step 1.
    $installed_defs['entity_id'] = $entity_id_definition;
    $kv->set('group_content.field_storage_definitions', $installed_defs);
  }

  // ---------------------------------------------------------------------------
  // Cache invalidation — must be aggressive enough that the next update hook
  // (group_update_9200) sees fresh entity type and plugin definitions.
  // ---------------------------------------------------------------------------
  \Drupal::entityTypeManager()->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  // Clear the group_content_enabler plugin cache if the service exists in 1.6.
  // Wrapped in try/catch because the service name differs between 1.x and 2.x
  // and this hook straddles that boundary.
  try {
    if (\Drupal::hasService('plugin.manager.group_content_enabler')) {
      \Drupal::service('plugin.manager.group_content_enabler')->clearCachedDefinitions();
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('epa_core')->notice(
      'group_content_enabler plugin cache clear skipped: @msg',
      ['@msg' => $e->getMessage()]
    );
  }

  return t(
    'Reversed Group patch 2797793: reinstalled entity_id base field, backfilled @count rows, dropped patch field tables.',
    ['@count' => $total_rows]
  );
}