<?php 

use Drupal\Core\Entity\EntityTypeInterface;

/**
  Implements hook_entity_base_field_info_alter()
*/
function lightning_scheduler_entity_base_field_info_alter(&$fields, EntityTypeInterface $entity_type) {
  if ($entity_type->id() === 'block_content' && isset($fields['scheduled_transition_date'])) {
    unset($fields['scheduled_transition_date']);
  }
}